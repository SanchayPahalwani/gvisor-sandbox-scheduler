{
  "ociVersion": "1.0.2",
  "process": {
    "user": {
      "uid": 1000,
      "gid": 1000
    },
    "args": [
      "python3",
      "/gss/zygote.py"
    ],
    "env": [
      "PATH=/usr/local/bin:/usr/bin:/bin",
      "HOME=/work",
      "LANG=C.UTF-8",
      "PYTHONUNBUFFERED=1",
      "OPENBLAS_NUM_THREADS=1",
      "OMP_NUM_THREADS=1",
      "GSS_PRIME=json"
    ],
    "cwd": "/work",
    "capabilities": {},
    "rlimits": [
      {
        "type": "RLIMIT_NOFILE",
        "hard": 1024,
        "soft": 1024
      }
    ],
    "noNewPrivileges": true
  },
  "root": {
    "path": "/r",
    "readonly": true
  },
  "hostname": "sandbox",
  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc"
    },
    {
      "destination": "/dev",
      "type": "tmpfs",
      "source": "tmpfs"
    },
    {
      "destination": "/sys",
      "type": "sysfs",
      "source": "sysfs",
      "options": [
        "nosuid",
        "noexec",
        "nodev",
        "ro"
      ]
    },
    {
      "destination": "/tmp",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": [
        "nosuid",
        "nodev",
        "mode=1777",
        "size=67108864"
      ]
    },
    {
      "destination": "/work",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": [
        "nosuid",
        "nodev",
        "mode=1777",
        "size=67108864"
      ]
    },
    {
      "destination": "/etc/hosts",
      "type": "bind",
      "source": "/b/sb1/hosts",
      "options": [
        "bind",
        "ro"
      ]
    }
  ],
  "linux": {
    "resources": {
      "memory": {
        "limit": 268435456
      },
      "cpu": {
        "quota": 50000,
        "period": 100000
      }
    },
    "cgroupsPath": "/gss/n1/sb1",
    "namespaces": [
      {
        "type": "pid"
      },
      {
        "type": "ipc"
      },
      {
        "type": "uts"
      },
      {
        "type": "mount"
      },
      {
        "type": "network"
      }
    ]
  }
}
